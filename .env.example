# PostgreSQL
WANDERLINE_DB_NAME=wanderline
WANDERLINE_DB_USER=wanderline
WANDERLINE_DB_PASSWORD=wanderline-local
WANDERLINE_DB_PORT=5432

# Backend
WANDERLINE_SERVER_PORT=8080
WANDERLINE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Routes API 服务端密钥；请使用独立密钥并将 API restriction 限制为 Routes API
GOOGLE_MAPS_SERVER_API_KEY=
WANDERLINE_MAP_REQUEST_TIMEOUT=PT12S

# Frontend (browser key; restrict it by HTTP referrer in Google Cloud Console)
WANDERLINE_FRONTEND_PORT=4173
VITE_API_BASE_URL=http://localhost:8080/api
VITE_GOOGLE_MAPS_API_KEY=
# 可选；本地留空时使用 DEMO_MAP_ID，生产环境应创建 JavaScript Map ID
VITE_GOOGLE_MAPS_MAP_ID=
